generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  BUYER
  SUPPLIER
  ADMIN
}

enum CompanyType {
  NACIONAL
  EXTRANJERO
}

enum MembershipType {
  GRATIS
  PREMIUM
}

enum VerificationStatus {
  PENDIENTE
  APROBADA
  RECHAZADA
}

enum RFQStatus {
  NUEVA
  RESPONDIDA
  CERRADA
}

enum ContactSource {
  RFQ
  PERFIL_GUARDADO
  MENSAJE
}

model User {
  id        String    @id @default(cuid())
  name      String?
  email     String    @unique
  password  String?
  role      Role      @default(BUYER)
  image     String?
  phone     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  companyId String?
  company   Company?  @relation(fields: [companyId], references: [id])
  sentRFQs  RFQ[]     @relation("BuyerRFQs")
  accounts  Account[]
  sessions  Session[]

  @@index([role])
}

model Company {
  id                 String             @id @default(cuid())
  slug               String             @unique
  name               String
  description        String?
  city               String?
  state              String?
  country            String             @default("México")
  companyType        CompanyType        @default(NACIONAL)
  membershipType     MembershipType     @default(GRATIS)
  verificationStatus VerificationStatus @default(PENDIENTE)
  isVerified         Boolean            @default(false)
  website            String?
  logoUrl            String?
  coverUrl           String?
  csfFileUrl         String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  users              User[]
  products           Product[]
  rfqRecipients      RFQRecipient[]
  receivedContacts   Contact[]          @relation("CompanyContacts")
  membership         Membership?

  @@index([membershipType, verificationStatus])
}

model Category {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  products    Product[]
}

model Product {
  id            String    @id @default(cuid())
  name          String
  slug          String    @unique
  description   String?
  price         Decimal?  @db.Decimal(10, 2)
  moq           Int?
  available     Boolean   @default(true)
  stockLabel    String?
  location      String?
  coverImageUrl String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  companyId     String
  categoryId    String
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category      Category  @relation(fields: [categoryId], references: [id])

  @@index([categoryId, companyId])
}

model RFQ {
  id          String         @id @default(cuid())
  title       String
  requirement String
  quantity    Int?
  deadline    DateTime?
  notes       String?
  status      RFQStatus      @default(NUEVA)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  buyerId     String
  buyer       User           @relation("BuyerRFQs", fields: [buyerId], references: [id], onDelete: Cascade)
  recipients  RFQRecipient[]
}

model RFQRecipient {
  id          String   @id @default(cuid())
  rfqId       String
  companyId   String
  createdAt   DateTime @default(now())
  response    String?
  respondedAt DateTime?
  rfq         RFQ      @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([rfqId, companyId])
}

model Contact {
  id                String         @id @default(cuid())
  buyerCompany      String
  buyerContact      String
  buyerEmail        String
  notes             String?
  source            ContactSource  @default(RFQ)
  createdAt         DateTime       @default(now())
  supplierCompanyId String
  supplierCompany   Company        @relation("CompanyContacts", fields: [supplierCompanyId], references: [id], onDelete: Cascade)
}

model Membership {
  id              String         @id @default(cuid())
  companyId       String         @unique
  type            MembershipType @default(GRATIS)
  startsAt        DateTime?
  endsAt          DateTime?
  monthlyPriceMx  Decimal?       @db.Decimal(10, 2)
  monthlyPriceUsd Decimal?       @db.Decimal(10, 2)
  company         Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
